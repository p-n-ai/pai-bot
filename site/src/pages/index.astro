---
import BaseLayout from "@/layouts/BaseLayout.astro";

const features = [
  {
    title: "Proactive learning",
    desc: "Starts study sessions, sends review nudges, and respects each learner's quiet hours.",
    icon: "M12 2a3 3 0 0 0-3 3v.35A6 6 0 0 0 6 11v3.2c0 .5-.2 1-.6 1.4L4 17h16l-1.4-1.4a2 2 0 0 1-.6-1.4V11a6 6 0 0 0-3-5.65V5a3 3 0 0 0-3-3Zm3 15v1a3 3 0 0 1-6 0v-1",
  },
  {
    title: "Spaced repetition",
    desc: "Schedules reviews at useful intervals and adapts practice to topic mastery.",
    icon: "M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a3 3 0 0 0 6 0M9 5a3 3 0 0 1 6 0m-6 9 2 2 4-4",
  },
  {
    title: "Battles and streaks",
    desc: "Turns curriculum practice into shared challenges, progress, and reasons to return.",
    icon: "M13 2 4 14h7v8l9-12h-7V2Z",
  },
  {
    title: "Multi-channel tutoring",
    desc: "Uses one learning record across Telegram, WhatsApp, and the embeddable web chat.",
    icon: "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.4-4 8-9 8a10 10 0 0 1-4.3-.95L3 20l1.4-3.7A7.2 7.2 0 0 1 3 12c0-4.4 4-8 9-8s9 3.6 9 8Z",
  },
  {
    title: "Curriculum-aware guidance",
    desc: "Grounds explanations, practice, and assessment in a structured school syllabus.",
    icon: "M12 6.25v13m0-13C10.8 5.5 9.25 5 7.5 5S4.2 5.5 3 6.25v13C4.2 18.5 5.75 18 7.5 18s3.3.5 4.5 1.25m0-13C13.2 5.5 14.75 5 16.5 5s3.3.5 4.5 1.25v13C19.8 18.5 18.25 18 16.5 18s-3.3.5-4.5 1.25",
  },
  {
    title: "Open and self-hostable",
    desc: "Runs under Apache 2.0 with cloud or local AI and full control of school data.",
    icon: "M10 20 14 4m4 4 4 4-4 4M6 16l-4-4 4-4",
  },
];

const providers = ["OpenAI", "Anthropic", "Google Gemini", "DeepSeek", "OpenRouter", "Ollama"];
const withBase = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}${path}`;
---

<BaseLayout title="P&AI Bot — Open-source AI learning agent">
  <main>
    <section class="mx-auto grid min-h-[calc(100svh-4rem)] max-w-[1180px] items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,0.92fr)_minmax(26rem,1.08fr)] lg:px-8 lg:py-20">
      <div class="max-w-2xl">
        <h1 class="max-w-[11ch] text-[clamp(3.1rem,5vw,4rem)] leading-[0.94] font-semibold tracking-[-0.045em] text-balance">
          AI tutor that starts the conversation.
        </h1>
        <p class="mt-7 max-w-[58ch] text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
          P&AI Bot teaches students through chat, remembers their progress, and returns with the right practice when it matters.
        </p>
        <p class="mt-3 text-sm font-medium text-foreground sm:text-base">
          Content is commodity. Motivation is the moat.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a
            href="https://t.me/pai_learning_bot"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center justify-center rounded-full bg-navigation px-6 text-sm font-semibold text-white no-underline transition-[background-color,color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none hover:bg-primary hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 active:scale-[0.96] motion-reduce:transform-none"
          >
            Try on Telegram
          </a>
          <a
            href={withBase("/getting-started/setup/")}
            class="inline-flex h-11 items-center justify-center rounded-full border border-primary bg-card px-6 text-sm font-semibold text-foreground no-underline transition-[background-color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 active:scale-[0.96] motion-reduce:transform-none"
          >
            Read the setup guide
          </a>
        </div>
      </div>

      <div class="relative overflow-hidden rounded-[28px] border border-primary bg-primary-subtle p-6 sm:p-8">
        <div class="grid items-center gap-6 sm:grid-cols-[minmax(0,1fr)_12rem] lg:grid-cols-1 xl:grid-cols-[minmax(0,1fr)_12rem]">
          <div>
            <p class="text-xs font-semibold tracking-[0.12em] text-muted-foreground uppercase">The learning loop</p>
            <h2 class="mt-3 max-w-[15ch] text-2xl leading-tight font-semibold tracking-[-0.025em] sm:text-3xl">
              Teach. Practise. Remember. Return.
            </h2>
          </div>
          <img
            src={withBase("/illustrations/pbot.svg")}
            alt="P&AI Bot mascot"
            class="mx-auto size-44 max-w-full sm:size-48"
          />
        </div>
        <div class="mt-6 grid gap-3">
          {[
            "Ground each answer in the curriculum.",
            "Use learner progress to choose the next activity.",
            "Start the next review without waiting for a question.",
          ].map((item, index) => (
            <div class="flex items-start gap-3 rounded-xl border border-primary bg-card px-4 py-3">
              <span class="mt-0.5 flex size-6 shrink-0 items-center justify-center rounded-full bg-navigation text-[11px] font-semibold text-white">
                {index + 1}
              </span>
              <p class="m-0 text-sm leading-6 text-muted-foreground">{item}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="border-y border-primary bg-card">
      <div class="mx-auto max-w-[1180px] px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
        <div class="max-w-2xl">
          <h2 class="text-3xl leading-tight font-semibold tracking-[-0.035em] sm:text-4xl">Built for learning that continues.</h2>
          <p class="mt-3 max-w-[62ch] text-base leading-7 text-muted-foreground">
            P&AI connects tutoring, practice, progress, and motivation in one learner-aware system.
          </p>
        </div>

        <div class="mt-10 grid border-t border-primary md:grid-cols-2">
          {features.map(({ title, desc, icon }) => (
            <article class="grid grid-cols-[2.75rem_minmax(0,1fr)] gap-4 border-b border-primary py-6 md:odd:border-r md:odd:pr-8 md:even:pl-8">
              <span class="flex size-11 items-center justify-center rounded-xl bg-primary-subtle text-navigation">
                <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d={icon} />
                </svg>
              </span>
              <div>
                <h3 class="text-base font-semibold tracking-[-0.015em]">{title}</h3>
                <p class="mt-1.5 text-sm leading-6 text-muted-foreground">{desc}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="bg-navigation text-white">
      <div class="mx-auto grid max-w-[1180px] gap-10 px-4 py-16 sm:px-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:px-8 lg:py-20">
        <div>
          <h2 class="text-3xl leading-tight font-semibold tracking-[-0.035em] sm:text-4xl">Use the AI provider that fits.</h2>
          <p class="mt-3 max-w-[48ch] text-base leading-7 text-nav-muted">
            Route teaching and assessment through cloud models, or keep inference on your infrastructure with Ollama.
          </p>
        </div>
        <div class="grid grid-cols-2 border-t border-white/20 sm:grid-cols-3">
          {providers.map((name) => (
            <p class="m-0 border-b border-white/20 py-5 text-sm font-semibold text-nav-muted sm:px-4">{name}</p>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-[1180px] px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
      <div class="grid items-center gap-8 rounded-[28px] border border-primary bg-card p-7 sm:p-10 lg:grid-cols-[minmax(0,1fr)_auto]">
        <div>
          <h2 class="text-3xl leading-tight font-semibold tracking-[-0.035em]">Run P&AI for your learners.</h2>
          <p class="mt-3 max-w-[58ch] text-base leading-7 text-muted-foreground">
            Try the tutor on Telegram, or follow the documentation to run the complete system yourself.
          </p>
        </div>
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row">
          <a
            href={withBase("/getting-started/introduction/")}
            class="inline-flex h-11 items-center justify-center rounded-full bg-navigation px-6 text-sm font-semibold text-white no-underline transition-[background-color,color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none hover:bg-primary hover:text-foreground focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 active:scale-[0.96] motion-reduce:transform-none"
          >
            Explore the docs
          </a>
          <a
            href="https://github.com/p-n-ai/pai-bot"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-11 items-center justify-center rounded-full border border-primary bg-card px-6 text-sm font-semibold text-foreground no-underline transition-[background-color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none hover:bg-muted focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 active:scale-[0.96] motion-reduce:transform-none"
          >
            View on GitHub
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
