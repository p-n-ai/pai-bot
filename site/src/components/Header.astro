---
const navItems = [
  { label: "Home", href: "/" },
  { label: "Docs", href: "/getting-started/introduction/" },
  { label: "GitHub", href: "https://github.com/p-n-ai/pai-bot", external: true },
];

const withBase = (path) => `${import.meta.env.BASE_URL.replace(/\/$/, "")}${path}`;
---

<header class="sticky top-0 z-50 border-b border-primary bg-background/95 backdrop-blur">
  <div class="mx-auto flex min-h-16 max-w-[1180px] items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a
      href={withBase("/")}
      class="flex shrink-0 items-center gap-3 rounded-xl text-foreground no-underline outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
    >
      <span class="flex size-9 items-center justify-center rounded-[10px] bg-navigation text-sm font-semibold text-white">P</span>
      <span class="text-sm font-semibold">P&AI Bot</span>
    </a>

    <nav aria-label="Primary navigation" class="flex items-center gap-0.5 sm:gap-1">
    {navItems.map(({ label, href, external }) => (
      <a
        href={external ? href : withBase(href)}
        class:list={[
          "rounded-full px-3 py-2 text-xs font-semibold transition-[background-color,color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 active:scale-[0.96] motion-reduce:transform-none sm:px-4 sm:text-sm",
          label === "Docs"
            ? "bg-navigation text-white hover:bg-primary hover:text-foreground"
            : "text-muted-foreground hover:bg-muted hover:text-foreground",
        ]}
        {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
      >
        {label}
      </a>
    ))}
    </nav>
  </div>
</header>
