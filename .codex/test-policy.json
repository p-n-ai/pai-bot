{
  "version": 1,
  "default_profile": "focused",
  "max_changed_files": 500,
  "max_inspected_file_bytes": 2000000,
  "profiles": {
    "focused": {
      "max_test_files_touched": 2,
      "max_new_test_files": 1,
      "max_deleted_test_files": 0,
      "max_added_test_lines": 180,
      "max_added_test_cases": 8,
      "max_inline_test_files_touched": 1,
      "max_test_infrastructure_files_touched": 1,
      "max_new_test_infrastructure_files": 0,
      "max_added_test_infrastructure_lines": 80,
      "max_expensive_test_files_touched": 1,
      "max_new_expensive_test_files": 0,
      "max_added_expensive_test_lines": 120,
      "max_snapshot_files_touched": 1,
      "max_new_snapshot_files": 1,
      "max_added_snapshot_lines": 50,
      "max_snapshot_added_lines_per_file": 50,
      "max_fixture_files_touched": 1,
      "max_new_fixture_files": 1,
      "max_added_fixture_lines": 120,
      "allow_binary_test_artifacts": false,
      "require_product_change": true,
      "allow_new_test_suite": false
    },
    "expanded": {
      "max_test_files_touched": 8,
      "max_new_test_files": 4,
      "max_deleted_test_files": 1,
      "max_added_test_lines": 1000,
      "max_added_test_cases": 40,
      "max_inline_test_files_touched": 3,
      "max_test_infrastructure_files_touched": 2,
      "max_new_test_infrastructure_files": 1,
      "max_added_test_infrastructure_lines": 250,
      "max_expensive_test_files_touched": 2,
      "max_new_expensive_test_files": 1,
      "max_added_expensive_test_lines": 350,
      "max_snapshot_files_touched": 3,
      "max_new_snapshot_files": 2,
      "max_added_snapshot_lines": 200,
      "max_snapshot_added_lines_per_file": 100,
      "max_fixture_files_touched": 4,
      "max_new_fixture_files": 2,
      "max_added_fixture_lines": 500,
      "allow_binary_test_artifacts": false,
      "require_product_change": true,
      "allow_new_test_suite": false
    },
    "tests-only": {
      "max_test_files_touched": 5,
      "max_new_test_files": 3,
      "max_deleted_test_files": 5,
      "max_added_test_lines": 800,
      "max_added_test_cases": 40,
      "max_inline_test_files_touched": 2,
      "max_test_infrastructure_files_touched": 4,
      "max_new_test_infrastructure_files": 3,
      "max_added_test_infrastructure_lines": 600,
      "max_expensive_test_files_touched": 1,
      "max_new_expensive_test_files": 0,
      "max_added_expensive_test_lines": 200,
      "max_snapshot_files_touched": 2,
      "max_new_snapshot_files": 1,
      "max_added_snapshot_lines": 100,
      "max_snapshot_added_lines_per_file": 50,
      "max_fixture_files_touched": 2,
      "max_new_fixture_files": 1,
      "max_added_fixture_lines": 250,
      "allow_binary_test_artifacts": false,
      "require_product_change": false,
      "allow_new_test_suite": true
    }
  },
  "test_file_patterns": [
    "test/**",
    "tests/**",
    "spec/**",
    "specs/**",
    "**/test/**",
    "**/tests/**",
    "**/spec/**",
    "**/specs/**",
    "__tests__/**",
    "**/__tests__/**",
    "**/test_*.py",
    "**/*_tests.*",
    "**/*_test.*",
    "**/*.test.*",
    "**/*.tests.*",
    "**/*.spec.*",
    "**/*Test.java",
    "**/*Tests.java",
    "**/*Test.kt",
    "**/*Tests.kt",
    "**/*Test.cs",
    "**/*Tests.cs",
    "**/*.feature",
    "**/*.bats"
  ],
  "test_infrastructure_patterns": [
    "**/jest.config.*",
    "**/vitest.config.*",
    "**/playwright.config.*",
    "**/cypress.config.*",
    "**/karma.conf.*",
    "**/wdio.conf.*",
    "**/pytest.ini",
    "**/tox.ini",
    "**/noxfile.py",
    "**/conftest.py",
    "**/setupTests.*",
    "**/setup-tests.*",
    "**/tests/setup.*",
    "**/test/setup.*",
    "**/tests/helpers/**",
    "**/tests/support/**",
    "**/test/helpers/**",
    "**/test/support/**",
    "**/test-utils/**",
    "**/test_utils/**",
    "**/test-helpers/**",
    "**/test_helpers/**"
  ],
  "expensive_test_patterns": [
    "e2e/**",
    "integration/**",
    "system/**",
    "acceptance/**",
    "**/e2e/**",
    "**/integration/**",
    "**/integration-tests/**",
    "**/system/**",
    "**/system-tests/**",
    "**/acceptance/**",
    "**/acceptance-tests/**",
    "**/*.e2e.*",
    "**/*.integration.*",
    "**/*E2E*.*",
    "**/*IntegrationTest*.*"
  ],
  "snapshot_patterns": [
    "**/__snapshots__/**",
    "**/snapshots/**",
    "**/*.snap",
    "**/*.snapshot"
  ],
  "fixture_patterns": [
    "**/fixture/**",
    "**/fixtures/**",
    "**/golden/**",
    "**/goldens/**",
    "**/*.golden",
    "**/testdata/**",
    "**/test-data/**"
  ],
  "support_only_patterns": [
    "**/*.md",
    "docs/**",
    "templates/**",
    ".codex/**",
    ".github/**",
    ".gitignore",
    ".editorconfig",
    "LICENSE*",
    "CHANGELOG*",
    "CODEOWNERS"
  ],
  "ignore_patterns": [
    ".codex/cache/**",
    "**/__pycache__/**",
    "**/*.pyc",
    "node_modules/**",
    "vendor/**",
    "dist/**",
    "build/**",
    "target/**",
    "coverage/**"
  ]
}
